# ---- Aplicacion ----
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ---- Base de datos (Postgres / Supabase) ----
# Local:    postgres://yako:yako@localhost:5432/yako
# Supabase: usar la connection string del pooler (puerto 6543) para la app
DATABASE_URL=postgres://yako:yako@localhost:5432/yako
# Conexion directa (puerto 5432 en Supabase). Solo la usan las migraciones.
DATABASE_MIGRATION_URL=postgres://yako:yako@localhost:5432/yako

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
# Secreto que Telegram devuelve en el header X-Telegram-Bot-Api-Secret-Token.
# Generar con: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# URL publica del servicio, usada para registrar el webhook al arrancar.
TELEGRAM_WEBHOOK_URL=

# ---- WhatsApp (Fase 5 - opcional, el canal queda inactivo si no se define) ----
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
